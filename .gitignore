tests/scenarios/*
!tests/scenarios/testbed_template/
testbed/

*.lock
uv.lock
.cache/

# Agent-managed local DB backups (rollback anchors, never committed)
.agents/backups/

# Plan E disposable research inputs/results (may contain private vault snapshots)
backend/research_spikes/local/

